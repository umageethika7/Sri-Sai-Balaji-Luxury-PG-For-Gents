# Copy this file to .env.local (development) and set the same values in your hosting provider's
# environment settings (production). Restart `yarn dev` / rebuild after changing them.

# The live website address, without a trailing slash. Used for the canonical URL, sitemap.xml,
# robots.txt and social-share (Open Graph) links.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Google Tag Manager container ID (Tag Manager > Admin > Container ID). Leave empty to disable GTM.
NEXT_PUBLIC_GTM_ID=
